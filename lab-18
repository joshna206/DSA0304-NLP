import re

def parse_fopc(expression):
    pattern = r'^(forall|exists)\s+([a-z])\s*\((.*)\)$'
    match = re.match(pattern, expression.strip(), re.I)

    if match:
        quantifier, variable, body = match.groups()
        print("Quantifier:", quantifier)
        print("Variable:", variable)
        print("Expression:", body)
    else:
        print("Invalid FOPC expression")

expr = input("Enter FOPC expression: ")
parse_fopc(expr)
